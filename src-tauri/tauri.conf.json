{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creative Creator Studio",
  "version": "0.1.0",
  "identifier": "org.creatorsuite.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Creative Creator Studio",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"], "color": [14, 15, 20, 150] }
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1430 http://localhost:1430"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Install and open the Creative Creator Studio apps",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
